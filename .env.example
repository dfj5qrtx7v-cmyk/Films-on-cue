# On Replit, add these in Tools > Secrets (never commit real values).
# Published sites need them added to the deployment's secrets too.

# Added automatically when you create a Replit PostgreSQL database
DATABASE_URL=

# Any long random string. Keeps you signed in across restarts.
SESSION_SECRET=

# Your Replit account's email address. Only this account can open the dashboard.
OWNER_EMAIL=

# Your site's public address, used in emails and share links (no trailing slash)
SITE_URL=https://filmsoncue.com

# Extra domains that can show the owner login, comma separated (your custom domain)
CUSTOM_DOMAINS=filmsoncue.com,www.filmsoncue.com

# Email via Resend (resend.com): newsletter and contact-form alerts
RESEND_API_KEY=
EMAIL_FROM=Films on Cue <hello@filmsoncue.com>

# Optional: Cloudflare Turnstile spam check on the public forms
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Optional: lets an outside scheduler trigger the weekly email with
# POST /cron/digest and the header "Authorization: Bearer <CRON_SECRET>"
CRON_SECRET=

# Local testing only (ignored on Replit): sign in without Replit Auth on localhost
DEV_LOGIN=false

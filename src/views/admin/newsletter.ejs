<%- include('_top') %>
<div class="admin-head"><h1>Newsletter</h1></div>

<% if (!emailEnabled) { %>
<section class="admin-box admin-setup" aria-labelledby="email-setup">
  <h2 id="email-setup">Email isn’t connected yet</h2>
  <p>Add <code>RESEND_API_KEY</code> and <code>EMAIL_FROM</code> as Secrets in Replit (the setup guide shows how). Until then, people who sign up are added straight away, and no emails are sent.</p>
</section>
<% } %>

<ul class="stat-row stat-row-3">
  <li><a href="/admin/newsletter?show=active"><span class="stat-num"><%= counts.active %></span> subscribed</a></li>
  <li><a href="/admin/newsletter?show=pending"><span class="stat-num"><%= counts.pending %></span> waiting to confirm</a></li>
  <li><a href="/admin/newsletter?show=unsubscribed"><span class="stat-num"><%= counts.unsubscribed %></span> unsubscribed</a></li>
</ul>

<div class="admin-cols">
  <section class="admin-box" aria-labelledby="next-heading">
    <h2 id="next-heading">This week’s email</h2>
    <% if (thisWeekSent) { %>
      <p>
        <% if (thisWeekSent.status === 'sent') { %>Sent on <%= formatDateTime(thisWeekSent.sent_at) %> to <%= thisWeekSent.recipients %> <%= thisWeekSent.recipients === 1 ? 'subscriber' : 'subscribers' %>.
        <% } else if (thisWeekSent.status === 'skipped') { %>Skipped this week because there were no new reviews.
        <% } else { %>Sending now.<% } %>
        New reviews will go in next week’s email.
      </p>
    <% } else { %>
      <% if (pending.reviews.length) { %>
        <p>It will include <%= pending.reviews.length %> new <%= pending.reviews.length === 1 ? 'review' : 'reviews' %>:</p>
        <ul class="plain-list"><% for (const r of pending.reviews) { %><li><%= r.title %></li><% } %></ul>
      <% } else { %>
        <p>No new reviews since the last email. If nothing is published before it’s due, this week’s email is skipped.</p>
      <% } %>
      <div class="button-row">
        <% if (pending.reviews.length) { %><a class="btn btn-line" href="/admin/newsletter/preview" target="_blank" rel="noopener"><%- icon('eye', { size: 18 }) %> Preview email</a><% } %>
        <% if (emailEnabled && pending.reviews.length) { %>
        <form method="post" action="/admin/newsletter/send">
          <input type="hidden" name="_csrf" value="<%= csrf %>">
          <button class="btn btn-ink" type="submit" data-confirm="Send this week’s email to <%= counts.active %> subscribers now?"><%- icon('mail', { size: 18 }) %> Send now</button>
        </form>
        <% } %>
      </div>
    <% } %>
  </section>

  <section class="admin-box" aria-labelledby="schedule-heading">
    <h2 id="schedule-heading">Schedule</h2>
    <form method="post" action="/admin/newsletter/settings" class="stack-form" novalidate>
      <input type="hidden" name="_csrf" value="<%= csrf %>">
      <label class="check"><input type="checkbox" name="autoSend"<%- settings.newsletter.autoSend ? ' checked' : '' %>> <span>Send automatically each week</span></label>
      <div class="field-grid">
        <div class="field">
          <label for="day">Day</label>
          <select id="day" name="day"><% DAY_NAMES.forEach((d, i) => { %><option value="<%= i %>"<%- settings.newsletter.day === i ? ' selected' : '' %>><%= d %></option><% }) %></select>
        </div>
        <div class="field">
          <label for="hour">Time (UK)</label>
          <select id="hour" name="hour"><% for (let h = 0; h < 24; h++) { %><option value="<%= h %>"<%- settings.newsletter.hour === h ? ' selected' : '' %>><%= hourLabel(h) %></option><% } %></select>
        </div>
      </div>
      <button class="btn btn-ink" type="submit">Save schedule</button>
    </form>
  </section>
</div>

<% if (digests.length) { %>
<section aria-labelledby="history-heading">
  <div class="admin-subhead"><h2 id="history-heading">Past emails</h2></div>
  <table class="admin-table">
    <thead><tr><th scope="col">Week</th><th scope="col">Result</th><th scope="col">Reviews</th><th scope="col">Sent to</th></tr></thead>
    <tbody>
      <% for (const d of digests) { %>
      <tr>
        <td><%= formatShortDate(d.created_at) %></td>
        <td data-label="Result"><%= { sent: 'Sent', skipped: 'Skipped: no new reviews', failed: 'Failed', sending: 'Sending' }[d.status] %><% if (d.error) { %><br><span class="muted small"><%= d.error %></span><% } %></td>
        <td data-label="Reviews"><%= d.review_ids.length %></td>
        <td data-label="Sent to"><%= d.recipients %></td>
      </tr>
      <% } %>
    </tbody>
  </table>
</section>
<% } %>

<section aria-labelledby="subs-heading">
  <div class="admin-subhead">
    <h2 id="subs-heading">Subscribers</h2>
    <a class="btn btn-line btn-small" href="/admin/newsletter/subscribers.csv"><%- icon('download', { size: 16 }) %> Download all (CSV)</a>
  </div>
  <nav class="tabs" aria-label="Filter subscribers">
    <% for (const [key, label] of [['active', 'Subscribed'], ['pending', 'Waiting to confirm'], ['unsubscribed', 'Unsubscribed']]) { %>
    <a href="/admin/newsletter?show=<%= key %>#subs-heading"<%- filter === key ? ' aria-current="page"' : '' %>><%= label %> <span class="tab-count"><%= counts[key] %></span></a>
    <% } %>
  </nav>
  <% if (subs.length) { %>
  <table class="admin-table">
    <thead><tr><th scope="col">Email</th><th scope="col">Signed up</th><th scope="col"><span class="visually-hidden">Actions</span></th></tr></thead>
    <tbody>
      <% for (const s of subs) { %>
      <tr>
        <td><%= s.email %></td>
        <td data-label="Signed up"><%= formatShortDate(s.created_at) %></td>
        <td class="cell-actions">
          <form method="post" action="/admin/newsletter/subscribers/<%= s.id %>/delete">
            <input type="hidden" name="_csrf" value="<%= csrf %>">
            <input type="hidden" name="show" value="<%= filter %>">
            <button class="link-button" type="submit" data-confirm="Remove <%= s.email %> completely? This can’t be undone.">Remove</button>
          </form>
        </td>
      </tr>
      <% } %>
    </tbody>
  </table>
  <% } else { %>
  <div class="admin-empty"><p>No one here yet.</p></div>
  <% } %>
</section>
<%- include('_bottom') %>

<%- include('../partials/head') %>
<%- include('../partials/header') %>
<%
  const r = review;
  const facts = [
    ['Released', r.release_year],
    ['Director', r.director],
    ['Certificate', r.certificate],
    ['Running time', r.runtime_minutes ? `${Math.floor(r.runtime_minutes / 60) ? Math.floor(r.runtime_minutes / 60) + 'h ' : ''}${r.runtime_minutes % 60}m` : null],
    ['Genre', r.genres.length ? r.genres.join(', ') : null],
    ['Where to watch', watchLabel ? `${watchLabel}${r.watch_detail ? ` (${r.watch_detail})` : ''}` : r.watch_detail],
  ].filter(([, v]) => v);
  const reviewer = settings.site.reviewer;
  const ld = {
    '@context': 'https://schema.org',
    '@type': 'Review',
    name: `${r.title} review`,
    url: `${siteUrl}/reviews/${r.slug}`,
    datePublished: new Date(r.published_at).toISOString(),
    dateModified: new Date(r.updated_at).toISOString(),
    reviewBody: r.excerpt,
    reviewRating: { '@type': 'Rating', ratingValue: Number(r.rating), bestRating: 5, worstRating: 0.5 },
    author: reviewer ? { '@type': 'Person', name: reviewer } : { '@type': 'Organization', name: settings.site.name },
    publisher: { '@type': 'Organization', name: settings.site.name, url: siteUrl },
    itemReviewed: Object.assign(
      { '@type': 'Movie', name: r.title },
      r.release_year ? { dateCreated: String(r.release_year) } : {},
      r.director ? { director: { '@type': 'Person', name: r.director } } : {},
      r.image_id ? { image: `${siteUrl}/media/${r.image_id}.jpg` } : {},
    ),
  };
%>
<main id="main">
  <article class="review">
    <header class="wrap review-head">
      <p class="crumb"><a href="/reviews">Reviews</a></p>
      <h1 class="display review-title"><%= r.title %><% if (r.release_year) { %> <span class="review-year">(<%= r.release_year %>)</span><% } %></h1>
      <div class="review-verdict">
        <%- starsHtml(r.rating, { size: 30 }) %>
        <span class="verdict-num"><%= formatRating(r.rating) %> out of 5</span>
      </div>
      <p class="byline"><% if (reviewer) { %>By <%= reviewer %>, <% } %><time datetime="<%= new Date(r.published_at).toISOString() %>"><%= formatDate(r.published_at) %></time></p>
    </header>

    <% if (r.image_id) { %>
    <figure class="wrap review-figure">
      <img src="<%= img(r.image_id) %>" alt="<%= r.image_alt || '' %>" width="1800" height="1012" fetchpriority="high">
      <% if (r.image_credit) { %><figcaption><%= r.image_credit %></figcaption><% } %>
    </figure>
    <% } %>

    <div class="wrap review-layout">
      <div class="review-main">
        <% if (r.has_spoilers) { %>
        <p class="notice"><strong>Spoiler warning.</strong> This review discusses plot details, including the ending.</p>
        <% } %>
        <div class="prose"><%- r.body_html %></div>
        <% if (trailer) { %>
        <section class="trailer" aria-labelledby="trailer-heading">
          <h2 id="trailer-heading">Trailer</h2>
          <div class="video"><iframe src="<%= trailer %>" title="<%= r.title %> trailer" loading="lazy" allow="encrypted-media; picture-in-picture; fullscreen" allowfullscreen></iframe></div>
        </section>
        <% } %>
      </div>
      <% if (facts.length) { %>
      <aside class="review-facts" aria-label="Film details">
        <dl>
          <% for (const [k, v] of facts) { %><div><dt><%= k %></dt><dd><%= v %></dd></div><% } %>
        </dl>
      </aside>
      <% } %>
    </div>
  </article>

  <section class="signup-band" aria-labelledby="nl-band-heading" id="newsletter">
    <div class="wrap signup-band-inner">
      <%- include('../partials/newsletter-form', { back: `/reviews/${r.slug}`, formId: 'nl-band' }) %>
    </div>
  </section>

  <% if (more.length) { %>
  <section class="section" aria-labelledby="more-heading">
    <div class="wrap">
      <div class="section-head">
        <h2 id="more-heading">More reviews</h2>
        <a class="text-link" href="/reviews">See all reviews</a>
      </div>
      <div class="grid-3">
        <% for (const m of more) { %><%- include('../partials/review-card', { r: m }) %><% } %>
      </div>
    </div>
  </section>
  <% } %>
</main>
<script type="application/ld+json" nonce="<%= nonce %>"><%- JSON.stringify(ld).replace(/</g, '\\u003c') %></script>
<%- include('../partials/footer') %>

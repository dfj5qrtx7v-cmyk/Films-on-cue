<%- include('../partials/head', { noindex: true }) %>
<%- include('../partials/header') %>
<main id="main">
  <section class="message-page">
    <div class="wrap">
      <div class="panel panel-paper message-panel">
        <% if (!sub) { %>
          <h1 class="display">This link has expired</h1>
          <p>We couldn’t find that subscription. If you’re still getting emails, reply to one and we’ll remove you.</p>
        <% } else if (done || sub.status === 'unsubscribed') { %>
          <h1 class="display">You’re unsubscribed</h1>
          <p>We won’t email <%= sub.email %> again. Changed your mind? You can <a href="/#newsletter">subscribe again</a> any time.</p>
        <% } else { %>
          <h1 class="display">Unsubscribe?</h1>
          <p>You’ll stop getting the weekly email at <%= sub.email %>.</p>
          <form method="post" action="/newsletter/unsubscribe/<%= token %>">
            <button class="btn btn-ink" type="submit">Unsubscribe</button>
          </form>
        <% } %>
      </div>
    </div>
  </section>
</main>
<%- include('../partials/footer') %>
